# Application
APP_PORT=3000
POSTGRES_PASSWORD=
# Use the same password as POSTGRES_PASSWORD, URL-encoded when necessary.
DATABASE_URL=
APP_URL=http://localhost:3000

# Resend transactional email. Verify the sender domain in Resend before production use.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Vínculo <convites@seu-dominio.com>"

# Optional legacy account. New accounts are created at /cadastro and stored in PostgreSQL.
AUTH_USER_ID=local-owner
AUTH_EMAIL=owner@example.com
AUTH_DISPLAY_NAME=Wedding owner
# For an existing legacy account, generate with: npm run auth:hash
# Keep the single quotes so Docker Compose treats the hash's $ characters literally.
AUTH_PASSWORD_HASH=''

# Luna AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional OpenAI-compatible endpoint. See README for trusted CA setup when using an HTTPS proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Cloudflare Turnstile challenge for login and registration.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only for deployments behind an HTTPS-inspecting proxy. Absolute host path to
# the proxy's trusted root CA PEM; use with docker-compose.tls.yml.
# OPENAI_CA_CERT_FILE=/absolute/path/to/proxy-root-ca.pem

# Local PostgreSQL host port
POSTGRES_PORT=5437
