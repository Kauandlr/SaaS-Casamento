# Application
APP_PORT=3000
DATABASE_URL=postgres://vinculo:vinculo@postgres:5432/vinculo

# Required for login.
AUTH_USER_ID=local-owner
AUTH_EMAIL=owner@example.com
AUTH_DISPLAY_NAME=Wedding owner
AUTH_PASSWORD=

# Luna AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional OpenAI-compatible endpoint. Must use a publicly trusted TLS certificate in Workers.
OPENAI_BASE_URL=https://api.openai.com/v1

# Local PostgreSQL host port
POSTGRES_PORT=5437
